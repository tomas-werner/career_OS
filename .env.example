# Career OS environment template — copy to .env and fill in real values.
# NEVER commit the real .env.

# Neon PostgreSQL connection string (uses the pooled connection)
POSTGRES_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# NVIDIA API key for AI extraction
nvidia_api_key=nvapi-REPLACE_ME

# App
APP_ENV=development
WEB_PORT=3000
PROXY_PORT=8080

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-random-32-chars

# Health check polling interval (ms)
HEALTH_TIMEOUT_MS=5000
